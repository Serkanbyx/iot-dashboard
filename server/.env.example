# Server
PORT=5000
NODE_ENV=development

# Database (Neon free tier in production)
DATABASE_URL=postgresql://user:pass@localhost:5432/iot_dashboard

# MQTT Broker (local Mosquitto for dev, HiveMQ Cloud for prod)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=factory

# JWT Authentication
JWT_SECRET=min-32-char-secret-here-change-me!
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Auth — set to false in production to disable public sign-up
ALLOW_REGISTRATION=true

# Email (Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_FROM=IoT Dashboard <you@gmail.com>
ALERT_EMAIL_TO=admin@example.com

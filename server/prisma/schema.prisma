generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VIEWER
}

enum SensorType {
  TEMPERATURE
  HUMIDITY
  PRESSURE
}

enum Severity {
  WARNING
  CRITICAL
}

enum Direction {
  ABOVE
  BELOW
}

enum AuditEntityType {
  DEVICE
  THRESHOLD
  USER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(50)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  role      Role      @default(VIEWER)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  acknowledgedAlerts Alert[]           @relation("AcknowledgedBy")
  thresholdConfigs   ThresholdConfig[] @relation("CreatedBy")
  devices            Device[]          @relation("DeviceCreatedBy")
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]        @relation("AuditActor")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ThresholdConfig {
  id          String     @id @default(uuid())
  sensorType  SensorType
  sensorId    String     @default("") @db.VarChar(50)
  minValue    Float
  maxValue    Float
  criticalMin Float
  criticalMax Float
  unit        String     @db.VarChar(10)
  isActive    Boolean    @default(true)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy User? @relation("CreatedBy", fields: [createdById], references: [id])

  @@unique([sensorType, sensorId])
  @@index([sensorId])
}

model Alert {
  id               String     @id @default(uuid())
  sensorId         String     @db.VarChar(50)
  floor            String     @db.VarChar(50)
  sensorType       SensorType
  value            Float
  threshold        Float
  severity         Severity
  direction        Direction
  message          String     @db.VarChar(200)
  isAcknowledged   Boolean    @default(false)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  acknowledgeNote  String?    @db.VarChar(500)
  emailSent        Boolean    @default(false)
  createdAt        DateTime   @default(now())

  acknowledgedBy User? @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([sensorId, sensorType, isAcknowledged])
  @@index([isAcknowledged, severity])
}

model Device {
  id          String       @id @default(uuid())
  sensorId    String       @unique @db.VarChar(50)
  name        String       @db.VarChar(100)
  floor       String       @db.VarChar(50)
  types       SensorType[]
  isActive    Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy User? @relation("DeviceCreatedBy", fields: [createdById], references: [id])

  @@index([floor])
  @@index([isActive])
}

model AuditLog {
  id         String          @id @default(uuid())
  entityType AuditEntityType
  entityId   String          @db.VarChar(100)
  action     AuditAction
  actorId    String
  summary    String          @db.VarChar(255)
  changes    Json?
  createdAt  DateTime        @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}
